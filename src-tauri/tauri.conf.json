{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "日常新闻",
  "version": "0.1.0",
  "identifier": "com.dianmao.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run web:dev",
    "beforeBuildCommand": "npm run web:build"
  },
  "app": {
    "windows": [
      {
        "title": "日常新闻",
        "width": 1180,
        "height": 760,
        "minWidth": 880,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "backgroundColor": "#0B0E13"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "dianmao",
    "copyright": "© 2026 dianmao",
    "category": "Utility",
    "shortDescription": "点卯 · 本地每日巡检板",
    "longDescription": "把你关心的网站收进卡片，按多级文件夹组织；今天没点过的卡片亮红点，点过就熄灭。所有数据保存在本地，不做任何上传。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
